    {
      "name": "Trip Operations (Quarry Operator)",
      "item": [
        {
          "name": "Post Check-in",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleNumber\": \"KA-01-ME-1234\",\n  \"transporterName\": \"VRL Logistics\",\n  \"quarryEntryTime\": \"\",\n  \"quarryEntryDate\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trips/checkin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips",
                "checkin"
              ]
            },
            "description": "Initializes a checkin entry for a lorry. Status becomes 'INSIDE_QUARRY'. Accessible only to QUARRY_OPERATOR. Timestamps fall back to now if empty."
          },
          "response": []
        },
        {
          "name": "Put Checkout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transitType\": \"DIGITAL\",\n  \"govtStationaryNumber\": \"STATION123\",\n  \"dispatchLocationId\": 1,\n  \"materialId\": 1,\n  \"wheelTypeId\": 1,\n  \"netWeightTonne\": 25.5,\n  \"amountEntry\": 1500,\n  \"userLat\": 13.082700,\n  \"userLng\": 80.270700,\n  \"quarryExitTime\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trips/checkout/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips",
                "checkout",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Trip sequential ID"
                }
              ]
            },
            "description": "Performs checkout logic: conditional check for digital stationary numbers, dynamic geofencing lookup against public.locations using dispatchLocationId, and state update to 'IN_TRANSIT'. Accessible only to QUARRY_OPERATOR."
          },
          "response": []
        }
      ]
    },
